# Server
PORT=3001
NODE_ENV=development
RATE_LIMIT_ENABLED=true  # Set to "false" to disable rate limiting (useful for tests)

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# JWT
JWT_SECRET=your_random_secret_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Email
RESEND_API_KEY=place_holder_resend_api_key
APP_URL=https://yourdomain.com(frontend)
API_URL=https://yourdomain.com(backend)

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=your_domain/api/v1/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=your_domain/api/v1/auth/github/callback

# Tenant API Key
ADMIN_SECRET=your-super-secret-key-here

# Image upload
CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret